generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ModelType {
  CHAT
  EMBEDDING
  IMAGE
  AUDIO
  VIDEO
  CODE
  MULTIMODAL
}

model Lab {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  website     String?
  country     String?
  logoUrl     String?
  models      Model[]
  createdAt   DateTime @default(now())
}

model Provider {
  id          String          @id @default(cuid())
  name        String          @unique
  slug        String          @unique
  description String?
  website     String?
  models      ModelProvider[]
  createdAt   DateTime        @default(now())
}

model Model {
  id            String            @id @default(cuid())
  name          String
  slug          String            @unique
  description   String?
  modelType     ModelType
  contextWindow Int
  maxOutput     Int?
  releaseDate   DateTime
  modalities    String[]
  capabilities  String[]
  isOpenSource  Boolean           @default(false)
  labId         String
  lab           Lab               @relation(fields: [labId], references: [id])
  providers     ModelProvider[]
  scores        BenchmarkScore[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([labId])
  @@index([releaseDate])
  @@index([contextWindow])
  @@index([modelType])
}

model ModelProvider {
  modelId         String
  providerId      String
  inputPricePerM  Decimal  @db.Decimal(10, 4)
  outputPricePerM Decimal  @db.Decimal(10, 4)
  latencyMs       Int?
  throughputTps   Int?
  model           Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  provider        Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@id([modelId, providerId])
  @@index([providerId])
}

model Benchmark {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  category    String
  description String?
  scores      BenchmarkScore[]
}

model BenchmarkScore {
  modelId     String
  benchmarkId String
  score       Float
  model       Model     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  benchmark   Benchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)

  @@id([modelId, benchmarkId])
  @@index([benchmarkId, score])
}